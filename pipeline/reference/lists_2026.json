{
 "_about": "The 38 candidate lists the Central Elections Committee approved for the 26th Knesset (27.9.2026; the disqualification of Ra'am and the Joint List was overturned by the Supreme Court on 2.10.2026), their ballot letters, and the surplus-vote agreements reported by the 16.10.2026 filing deadline. Read by pipeline/test_live.py against build_polls.LETTERS_2026, live_fetch.AGREEMENTS_2026 and live_model.BASE_MAP['K26'], and by pipeline/fetchers/cec_lists.py, which fetches the CEC's own pages from a GitHub runner (the build container cannot reach gov.il) and compares them with this file.",
 "verified_means": {
  "letters": "the letters are those of the CEC table as captured by two independent GitHub mirrors (mirrors), and at least one news report on the approval names this list with these letters (letter_sources)",
  "agreement": "the agreement (or, with agreement null, its absence) as reported in the news by noon 16.10.2026 (agreements, no_agreement); for the 15 modelled lists only",
  "cec": "read on the CEC's own page or file by pipeline/fetchers/cec_lists.py; false for everything until the runner fetch is read (request {\"workflow\": \"fetch\", \"what\": \"cec_lists\"})"
 },
 "fields": {
  "letters": "the ballot letters (the column header of the list in the CEC's results files)",
  "id": "the list's id in build_polls.PARTIES_2026 (the 15 lists the site models), else null (counted as other)",
  "cec_list_no": "the number in the CEC's index (submission order; the suffix of cec_key)",
  "requested_letters": "the letters the list asked for, first choice first (the 19.9 index)",
  "first_candidates": "the first two names on the submitted roster (the 19.9 capture)",
  "agreement": "the letters of the surplus-vote partner, null for none (modelled lists only)",
  "cec_sources": "the CEC page(s) whose table of approved lists has this list with these letters (cec_check; verified.cec true)"
 },
