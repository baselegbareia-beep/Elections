ם","alt":null,"id":"sideNav_2","url":"/he/pages/candidates-lists-26?chapterIndex=3","isExternal":false},{"description":null,"metaData":null,"title":"הסכמים בין מפלגות","alt":null,"id":"sideNav_3","url":"/he/pages/candidates-lists-26?chapterIndex=4","isExternal":false},{"description":null,"metaData":null,"title":"באי כח הסיעות וממלאי מקומם","alt":null,"id":"sideNav_4","url":"/he/pages/candidates-lists-26?chapterIndex=5","isExternal":false},{"description":null,"metaData":null,"title":"הסכמי עודפים","alt":null,"id":"sideNav_5","url":"/he/pages/candidates-lists-26?chapterIndex=6","isExternal":false},{"description":null,"metaData":null,"title":"הליך הגשת רשימות מועמדים לכנסת","alt":null,"id":"sideNav_6","url":"/he/pages/candidates-lists-26?chapterIndex=7","isExternal":false},{"description":null,"metaData":null,"title":"הנחיות להגשת רשימות המועמדים","alt":null,"id":"sideNav_7","url":"/he/pages/candidates-lists-26?chapterIndex=8","isExternal":false},{"description":null,"metaData":null,"title":"רשימת האותיות ה\"תפוסות\" וה\"פנויות\"","alt":null,"id":"sideNav_8","url":"/he/pages/candidates-lists-26?chapterIndex=9","isExternal":false}],"name":"candidates-lists-26_guide","prevDesc":"הקודם","nextDesc":"הבא","allNavItemsDesc":"לכל הפרקים","navAriaLabel":"פרקי המדריך Guide chapters"},"images":[],"htmlContents":[{"id":"htmlContent_0","order":2,"sectionData":"<p><a href=\"https://www.gov.il/BlobFolder/guide/candidates-lists-26/he/yp15045.pdf\">הודעה על התקשרויות בין רשימות המועמדים – ילקוט הפרסומים, חוברת 15045, עמ' 1098, מיום 19 באוקטובר 2026</a><br><br>נמסרת בזה הודעה, בהתאם לסעיף 67(ג) לחוק הבחירות לכנסת [נוסח משולב], התשכ\"ט–1969, כי רשימות המועמדים &nbsp;שלהלן התקשרו ביניהן לשם חלוקת מנדטים:</p><p>(1) ביחד בראשות נפתלי בנט – רק</p><p>עם</p><p>ישראל ביתנו בראשות אביגדור ליברמן – ל<br>&nbsp;</p><p>(2) הרשימה המשותפת – ודם</p><p>עם</p><p>רע\"ם הרשימה הערבית המאוחדת – עם<br>&nbsp;</p><p>(3) הציונות הדתית בראשות בצלאל סמוטריץ' וזהות בראשות משה פייגלין – ט</p><p>עם</p><p>הליכוד בהנהגת בנימין נתניהו לראשות הממשלה – מחל<br>&nbsp;</p><p>(4) יהדות התורה והשבת אגודת ישראל – דגל התורה – ג</p><p>עם</p><p>התאחדות הספרדים שומרי תורה תנועתו של מרן הרב עובדיה יוסף זצ\"ל – שס<br>&nbsp;</p><p>(5) הדמוקרטים בראשות יאיר גולן – אמת</p><p>עם</p><p>ישר! עם איזנקוט לראשות הממשלה מאחדים את ישראל – דרך<br>&nbsp;</p><p>(6) ברית עולם לגאולת ישראל – זץ</p><p>עם</p><p>התיקון לשיטת הבחירות והממשל – נקי</p>"}],"roleHolders":null,"faqs":null,"disclaimers":null,"imageGallerys":[],"buttons":[]},"contentSub":{"moreOnSameTopic":null,"filesToDownload":{"id":"filesToDownload","title":"קבצים מצורפים","zipTitle":"רשימות המועמדים לכנסת","filesGroupItems":[{"items":[{"fileName":"yp15045.pdf","fileMime":"application/pdf","fileSize":"112989","extension":"pdf","displayName":"רשומות, ילקוט הפרסומים 15045","description":null,"metaData":null,"title":null,"alt":null,"id":null,"url":"https://www.gov.il/BlobFolder/guide/candidates-lists-26/he/yp15045.pdf","isExternal":false}],"isExpanded":false,"title":""}],"downloadAllButton":"להורדת כל הקבצים","size":"משקל","type":"סוג הקובץ"},"contactUs":null},"contentResources":{"noticeInfo":"הידעתם?","payAttention":"שימו לב","openInNewTab":"נפתח בחלון חדש","pageSharingOptions":"אפשרויות שיתוף הדף","shareLabel":"שתפו:"},"contentType":"guide","officeId":"26857f24-4eaa-4032-a39d-5dc66d374ee3","officeName":"ועדת הבחירות המרכזית לכנסת","officeUrlName":"central-elections-committee","redirectUrl":"","robotsMetadataContent":null}